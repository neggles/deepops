{
  "editor.insertSpaces": true,
  "editor.tabSize": 4,
  "editor.rulers": [100, 120],
  "files.trimTrailingWhitespace": true,

  "prettier.useTabs": false,
  "prettier.tabWidth": 4,
  "prettier.printWidth": 110,

  "git.autoRepositoryDetection": "subFolders",
  "git.repositoryScanMaxDepth": 1,
  "git.repositoryScanIgnoredFolders": ["submodules/*"],
  "githubRepositories.autoFetch.enabled": false,

  "files.associations": {
    "*.log": "log",
    "${workspaceFolder}/config/**/*.{yml,yaml}": "ansible",
    "${workspaceFolder}/config.example/**/*.{yml,yaml}": "ansible",
    "**/playbooks/**/*.{yml,yaml}": "ansible",
    "**/roles/**/*.{yml,yaml}": "ansible",
    "**/tasks/**/*.{yml,yaml}": "ansible",
    "**/group_vars/**/*.{yml,yaml}": "ansible",
    "**/host_vars/**/*.{yml,yaml}": "ansible",
    "**/vars/**/*.{yml,yaml}": "ansible",
    "**/meta/**/*.{yml,yaml}": "ansible",
    "*.{yml,yaml}.j2": "jinja-yaml",
    "*.service.j2": "jinja-properties",
    "**/config/logs/**/*": "log"
  },
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/CVS": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true,
    "**/.ruff_cache": true,
    "**/__pycache__": true,
    "**/*.egg-info": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/bower_components": true,
    "**/*.code-search": true,
    "**/.ruff_cache": true,
    "**/.venv": true,
    "**/venv": true,
    "**/collections": true,
    "**/roles/galaxy": true
  },

  "[python]": {
    "diffEditor.ignoreTrimWhitespace": false,
    "gitlens.codeLens.symbolScopes": ["!Module"],
    "editor.formatOnType": false,
    "editor.formatOnSave": true,
    "editor.wordBasedSuggestions": "off"
  },
  "ruff.lineLength": 110,
  "ruff.importStrategy": "fromEnvironment",

  "[ansible]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.detectIndentation": false,
    "editor.formatOnSave": true,
    "editor.formatOnSaveMode": "file",
    "editor.tabSize": 2,
    "editor.autoIndent": "advanced",
    "prettier.bracketSpacing": false,
    "prettier.tabWidth": 2,
    "yaml.validate": false
  },
  "ansible.python.interpreterPath": "${workspaceFolder}/.venv/bin/python",
  "ansible.validation.lint.arguments": "-c .ansible-lint",
  "ansible.lightspeed.enabled": false,

  "[shellscript]": {
    // "editor.defaultFormatter": "foxundermoon.shell-format",
    "editor.detectIndentation": false,
    "editor.formatOnSave": true,
    "editor.formatOnSaveMode": "file",
    "editor.tabSize": 4,
    "files.eol": "\n"
  },

  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.detectIndentation": false,
    "editor.formatOnSaveMode": "file",
    "editor.formatOnSave": true,
    "editor.tabSize": 2,
    "prettier.tabWidth": 2,
    "prettier.printWidth": 110
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.detectIndentation": false,
    "editor.formatOnSaveMode": "file",
    "editor.formatOnSave": true,
    "editor.tabSize": 2,
    "prettier.tabWidth": 2
  },

  "[toml]": {
    "editor.defaultFormatter": "tamasfe.even-better-toml",
    "editor.detectIndentation": false,
    "editor.tabSize": 4,
    "editor.formatOnSave": true
  },

  "[yaml]": {
    "editor.defaultFormatter": "redhat.vscode-yaml",
    "editor.detectIndentation": false,
    "editor.formatOnSaveMode": "file",
    "editor.formatOnSave": true,
    "editor.tabSize": 2,
    "diffEditor.ignoreTrimWhitespace": false
  },
  "yaml.format.proseWrap": "preserve",
  "yaml.format.singleQuote": false,
  "yaml.format.printWidth": 110,
  "yaml.format.bracketSpacing": false,

  "[markdown]": {
    "files.trimTrailingWhitespace": false
  },
  "yaml.schemas": {},
  "yaml.maxItemsComputed": 10000
}
